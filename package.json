{
  "name": "@suzumiyaaoba/voicevox-client",
  "version": "0.2.0",
  "description": "TypeScript client library for VOICEVOX ENGINE OSS. Auto-generated from OpenAPI schema using openapi-fetch and openapi-typescript.",
  "homepage": "https://github.com/SuzumiyaAoba/voicevox-client",
  "bugs": {
    "url": "https://github.com/SuzumiyaAoba/voicevox-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuzumiyaAoba/voicevox-client.git"
  },
  "author": {
    "name": "SuzumiyaAoba",
    "url": "https://github.com/SuzumiyaAoba"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/SuzumiyaAoba"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "build:dual": "yarn build && yarn build:cjs",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --outDir dist-cjs && mv dist-cjs/index.js dist/index.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate": "tsx scripts/generate-types.ts",
    "format": "biome check --write .",
    "check": "biome check .",
    "fix": "yarn format",
    "update-schema": "curl -s -o api-schema/openapi.json http://localhost:50021/openapi.json && echo 'OpenAPI schema updated from local server' && yarn generate",
    "voicevox:start": "docker-compose up -d voicevox",
    "voicevox:stop": "docker-compose down",
    "voicevox:logs": "docker-compose logs -f voicevox",
    "prepublishOnly": "yarn generate && yarn test:run && yarn build:dual",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "voicevox",
    "voice-synthesis",
    "tts",
    "text-to-speech",
    "api-client",
    "typescript",
    "openapi",
    "openapi-fetch",
    "openapi-typescript",
    "audio",
    "speech",
    "japanese",
    "voicevox-engine"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "yarn": ">=4.18.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
